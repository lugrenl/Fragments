<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingStart="16dp"
    android:paddingTop="128dp">

    <TextView
        android:id="@+id/fragment_part5_root_text"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Part 5 root"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/fragment_part5_root_text__counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:text="Fragments count: 0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fragment_part5_root_text" />

    <Button
        android:id="@+id/fragment_part5_button__add_a_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Fragment A"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/fragment_part5_root_text__counter" />

    <Button
        android:id="@+id/fragment_part5_button__add_b_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Fragment B"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/fragment_part5_button__add_a_fragment" />

    <Button
        android:id="@+id/fragment_part5_button__replace_with_c_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Replace with fragment C"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/fragment_part5_button__add_b_fragment" />

    <Button
        android:id="@+id/fragment_part5_button__remove_last_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remove last fragment"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/fragment_part5_button__replace_with_c_fragment" />/>

</androidx.constraintlayout.widget.ConstraintLayout>